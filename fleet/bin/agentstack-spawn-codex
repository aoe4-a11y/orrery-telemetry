#!/usr/bin/env bash
# One-shot: pre-register + spawn a Codex tmux child with an embedded task file.
# Usage: agentstack-spawn-codex <model> <task-file> [workdir] [task-description] [effort]
# Env: PARENT_AGENT (default ProudTuring), AGENTSTACK_PROJECT_KEY
# AGENTSTACK_PROJECT_KEY comes from the installed environment.
set -euo pipefail

# FLEET-MEM-1 / R-183: refuse before registration, state changes or process launch.
# 11-08 owner (chat「分けてよい」): a station that uses Simulator/Xcode is admitted as heavy
# (largest-seat estimate); every other station is light (2 GiB). The task file is only grepped.
if [[ -z "${AGENTSTACK_MEMORY_SEAT_WEIGHT:-}" && -f "${2:-}" ]] \
   && grep -Eqi 'simulator|simctl|sim_lease|xcodebuild|xcuitest|xctrace' "$2"; then
    export AGENTSTACK_MEMORY_SEAT_WEIGHT=heavy
fi
"${AGENTSTACK_HOME:-$HOME/.agentstack}/bin/agentstack-memory-budget" admit || exit $?
[ -f "${AGENTSTACK_HOME:-$HOME/.agentstack}/env.sh" ] && source "${AGENTSTACK_HOME:-$HOME/.agentstack}/env.sh"
export AGENTSTACK_HOME="${AGENTSTACK_HOME:-$HOME/.agentstack}"
HOOKS_DIR="${AGENTSTACK_LIFECYCLE_HOOKS_DIR:-${AGENTSTACK_HOOKS_DIR:-$AGENTSTACK_HOME/hooks}}"
export AGENTSTACK_HOOKS_DIR="${AGENTSTACK_HOOKS_DIR:-$AGENTSTACK_HOME/hooks}"
MODEL="${1:?model (e.g. gpt-5.6-sol)}"; TASK="${2:?task file}"; WORKDIR="${3:-$PWD}"; DESC="${4:-$(head -1 "$TASK" | sed 's/^# *//' | python3 -c 'import sys; print(sys.stdin.read().strip()[:60])')}"; EFFORT="${5:-medium}"
export PARENT_AGENT="${PARENT_AGENT:-ProudTuring}"
export AGENTSTACK_PROJECT_KEY="${AGENTSTACK_PROJECT_KEY:?configured project key required}"
HANDOFF_DIR="${AGENTSTACK_RUNTIME_DIR:-${AGENTSTACK_HOME:-$HOME/.agentstack}/runtime}/spawn-tokens"
mkdir -p "$HANDOFF_DIR"
chmod 700 "$HANDOFF_DIR"
# Guard the server-returned name even when preregistration is supplied externally.
. "$AGENTSTACK_HOME/bin/lib/agentstack-child-name.sh"
preregister_child_attempt() {
  TOK="$HANDOFF_DIR/$(python3 -c 'import uuid; print(uuid.uuid4().hex)').token"
  OUT="$("$AGENTSTACK_HOME/bin/agentstack-preregister-child" --project-key "$AGENTSTACK_PROJECT_KEY" --program codex --model "$MODEL" --task-description "$DESC" --token-file-out "$TOK" 2>&1)" || { local code=$?; printf '%s\n' "$OUT" >&2; return "$code"; }
  NAME="$(printf '%s\n' "$OUT" | tail -1 | tr -d '[:space:]')"
  [[ "$NAME" =~ ^[A-Z][a-z]+[A-Z][a-z]+$ ]] || { printf '%s\n' 'preregister failed:' "$OUT" >&2; return 1; }
  AGS_CHILD_NAME="$NAME"
}
ags_child_name_retry "$AGENTSTACK_PROJECT_KEY" preregister_child_attempt || exit $?
cd "$WORKDIR"
"$HOOKS_DIR/spawn_child.sh" --codex --model "$MODEL" --effort "$EFFORT" --pre-registered "$NAME" --child-token-file "$TOK" --embed-task --task-file "$TASK" "$WORKDIR"
echo "spawned: $NAME (tmux session $NAME, model $MODEL, effort $EFFORT, parent $PARENT_AGENT, workdir $WORKDIR)"

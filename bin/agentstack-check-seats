#!/usr/bin/env bash
# 席の死活を「便が来ない」ではなく実体で見る。誰でも読める read-only 点検。
# Usage: agentstack-check-seats
# 出力: 席名 / model / 状態 / cwd。状態が DEAD-CWD / NO-PANE の席は agentstack-restart-seat で建て直す。
set -uo pipefail
printf '%-18s %-22s %-12s %s\n' SEAT MODEL STATE CWD
tmux list-sessions -F '#{session_name}' 2>/dev/null | sort | while read -r s; do
  pane="$(tmux capture-pane -p -t "$s" 2>/dev/null || true)"
  cwd="$(tmux display-message -p -t "$s" '#{pane_current_path}' 2>/dev/null || true)"
  # 起動引数が正本（10-31 M-100: 画面の文字列と mail DB の登録値は古い model を出していた）。
  # 席の pane の子孫の codex の process の --model と model_reasoning_effort を読む。
  model=""
  ppid="$(tmux display-message -p -t "$s" '#{pane_pid}' 2>/dev/null || true)"
  if [ -n "$ppid" ]; then
    # pane に最も近い（段の少ない）codex を席の本体とする。下請けの codex も pane の子孫で、
    # pgrep の順で先に当たると下請けの model を出していた（11-03 CuriousLavoisier を Sol と誤表示・2 回止めた）。
    best_depth=99
    for c in $(pgrep -f 'aarch64-apple-darwin/bin/codex' 2>/dev/null); do
      x="$c"; hit=""; depth=0
      for _ in 1 2 3 4 5 6 7 8; do depth=$((depth+1)); x="$(ps -o ppid= -p "$x" 2>/dev/null | tr -d ' ')"; [ -z "$x" ] && break; [ "$x" = "$ppid" ] && { hit=1; break; }; done
      [ -n "$hit" ] || continue
      args="$(ps -o command= -p "$c" 2>/dev/null | tr ' ' '\n')"
      # 最初の --model だけを読む（引数に埋まった文の中の --model を拾わない）。
      m="$(printf '%s\n' "$args" | grep -A1 -x -m1 -- '--model' | sed -n 2p)"
      e="$(printf '%s\n' "$args" | grep -oE '^model_reasoning_effort=[a-z]+' | head -1 | cut -d= -f2)"
      # --model の無い子（下請けの補助の process など）は飛ばす（11-01 Mighty を Sol と誤表示）。
      [ -n "$m" ] || continue
      [ "$depth" -lt "$best_depth" ] && { best_depth=$depth; model="$m${e:+/$e}"; }
    done
  fi
  [ -z "$model" ] && model="$(printf '%s' "$pane" | grep -oiE '(gpt|claude)-[A-Za-z0-9.-]+( (sol|terra|luna|astra))? +(low|medium|high|xhigh|max|ultra)' | tail -1 | tr ' ' '/')"
  # Claude 席は statusline に effort を出さない。mail DB の登録値を使う（登録時の値で古いことがある）。
  if [ -z "$model" ]; then
    model="$(sqlite3 "$HOME/.agentstack/mail/storage.sqlite3" "select model from agents where name='$s' and retired_at is null limit 1;" 2>/dev/null)"
  fi
  state=OK
  if printf '%s' "$pane" | grep -q 'invalid cwd'; then state=DEAD-CWD
  elif [ -z "$cwd" ] || [ ! -d "$cwd" ]; then state=DEAD-CWD
  elif printf '%s' "$pane" | grep -qE 'Working \(|esc to interrupt|Crunch|Quantumiz'; then state=WORKING
  elif printf '%s' "$pane" | grep -qE 'Ask Codex to do anything|auto mode on'; then state=IDLE
  else state=UNKNOWN; fi
  case "$cwd" in */DevStorageGovernor/artifacts/*) state="$state!ARTIFACT-CWD";; esac
  printf '%-18s %-22s %-12s %s\n' "$s" "${model:--}" "$state" "${cwd:-<gone>}"
done

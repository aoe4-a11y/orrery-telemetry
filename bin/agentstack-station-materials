#!/usr/bin/env python3
"""METHOD-COPY-1: refer to exact inputs; clone only explicitly selected files.

A clone never traverses directories or falls back to a byte copy. Worktree
recovery audits a checkout before resuming or explicitly removing it.
A reference binds a resolved file and a frozen byte prefix, so an active rollout
may append without invalidating the previously recorded prefix. Private manifests
must be written in the station's encrypted record root, never committed to Git.
"""
from __future__ import annotations

import argparse
import ast
import ctypes
from contextlib import contextmanager
from datetime import datetime, timezone
import errno
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import signal
import stat
import subprocess
import sys
import tempfile


PROJECT_ALIASES = {}  # __FLEET_PROJECT_ALIASES_ASSIGNMENT__
RECORD_DIRECTORIES = ("comms", "docs/receipts", "docs/evidence", "docs/reports")


def canonical_project(project: str) -> str:
    """Normalize NEW allocation arguments, never rewrite existing metadata."""
    return PROJECT_ALIASES.get(project, project)


def fingerprint(path: Path) -> dict:
    resolved = path.resolve(strict=True)
    if not stat.S_ISREG(resolved.stat().st_mode):
        raise ValueError("input must be one regular file")
    with resolved.open("rb") as stream:
        before = os.fstat(stream.fileno())
        if not stat.S_ISREG(before.st_mode):
            raise ValueError("input must be one regular file")
        remaining = before.st_size
        digest = hashlib.sha256()
        while remaining:
            block = stream.read(min(1024 * 1024, remaining))
            if not block:
                raise ValueError("input shrank while hashing")
            digest.update(block)
            remaining -= len(block)
        after = os.fstat(stream.fileno())
    # A rollout may only grow. Same-sized mutable inputs must remain unchanged.
    if (before.st_dev, before.st_ino) != (after.st_dev, after.st_ino):
        raise ValueError("input identity changed")
    if after.st_size < before.st_size or (after.st_size == before.st_size and
                                        after.st_mtime_ns != before.st_mtime_ns):
        raise ValueError("input changed while hashing")
    return {"path": str(resolved), "bytes": before.st_size,
            "sha256": digest.hexdigest(), "hash_scope": "prefix",
            "device": before.st_dev, "inode": before.st_ino}


def verify_reference(row: dict) -> bool:
    """Verify the exact recorded bytes, allowing subsequent appends."""
    if row.get("hash_scope") != "prefix" or type(row.get("bytes")) is not int or row["bytes"] < 0:
        raise ValueError("invalid reference")
    path = Path(row["path"])
    if not stat.S_ISREG(path.stat().st_mode):
        raise ValueError("reference must resolve to a regular file")
    digest = hashlib.sha256()
    remaining = row["bytes"]
    with path.open("rb") as stream:
        if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
            raise ValueError("reference must resolve to a regular file")
        while remaining:
            block = stream.read(min(1024 * 1024, remaining))
            if not block:
                return False
            digest.update(block)
            remaining -= len(block)
    return digest.hexdigest() == row["sha256"]


def clone_file(source: Path, destination: Path) -> dict:
    """Independent COW file, fail closed across volumes or on existing paths."""
    source = source.resolve(strict=True)
    if not source.is_file():
        raise ValueError("clone selects one regular file, not a directory")
    if os.path.lexists(destination):
        raise FileExistsError(destination)
    if sys.platform != "darwin":
        raise OSError(errno.ENOTSUP, "APFS clone is required")
    if source.stat().st_dev != destination.parent.stat().st_dev:
        raise OSError(errno.EXDEV, "cross-volume clone refused; use a reference")
    reference = fingerprint(source)
    libc = ctypes.CDLL(None, use_errno=True)
    clone = libc.clonefile
    clone.argtypes = [ctypes.c_char_p, ctypes.c_char_p, ctypes.c_uint32]
    clone.restype = ctypes.c_int
    if clone(os.fsencode(source), os.fsencode(destination), 1):
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error), str(destination))
    result = fingerprint(destination)
    if result["bytes"] != reference["bytes"] or result["sha256"] != reference["sha256"]:
        # Keep partial evidence; this tool never deletes files.
        raise ValueError("source changed or clone verification failed; preserve both")
    return {"method": "apfs-clone", "source": reference, "destination": result,
            "copied_payload_bytes": 0}


def write_new_json(path: Path, value: dict) -> None:
    # Exclusive creation prevents a mistaken output path from replacing source.
    with path.open("x", encoding="utf-8") as stream:
        json.dump(value, stream, ensure_ascii=False, indent=2)
        stream.write("\n")


def test_string_literals(text: str, suffix: str) -> set[str]:
    """Read constants without executing tests or consuming comments as paths."""
    if suffix == ".py":
        values = set()

        def visit(node):
            if isinstance(node, ast.Constant) and isinstance(node.value, str):
                values.add(node.value)
            elif isinstance(node, ast.JoinedStr):
                parts = []
                for part in node.values:
                    if isinstance(part, ast.Constant) and isinstance(part.value, str):
                        parts.append(part.value)
                    elif isinstance(part, ast.FormattedValue):
                        # Keep the static prefix even when data, attributes or
                        # formatting determine the runtime value. "?" cannot
                        # match the finite-identifier selector below.
                        variable = (part.value.id if isinstance(part.value, ast.Name)
                                    and part.format_spec is None else "?")
                        parts.append("\\(" + variable + ")")
                    else:
                        return
                values.add("".join(parts))
            else:
                for child in ast.iter_child_nodes(node):
                    visit(child)

        visit(ast.parse(text))
        return values

    # Swift (including raw/multiline strings) and quoted shell test constants.
    values, i = set(), 0
    while i < len(text):
        if text.startswith("//", i) or (suffix == ".sh" and text[i] == "#"):
            end = text.find("\n", i)
            i = len(text) if end < 0 else end + 1
            continue
        if text.startswith("/*", i):
            depth, i = 1, i + 2
            while i < len(text) and depth:
                if text.startswith("/*", i):
                    depth, i = depth + 1, i + 2
                elif text.startswith("*/", i):
                    depth, i = depth - 1, i + 2
                else:
                    i += 1
            continue
        start = i
        while i < len(text) and text[i] == "#":
            i += 1
        hashes = text[start:i]
        if i >= len(text) or text[i] not in ('"', "'"):
            i = max(i, start + 1)
            continue
        quote = text[i]
        delimiter = quote * (3 if text.startswith(quote * 3, i) else 1)
        i += len(delimiter)
        begin, closing = i, delimiter + hashes
        while i < len(text) and not text.startswith(closing, i):
            if text[i] == "\\" and not hashes:
                i += 2
            else:
                i += 1
        if i < len(text):
            value = text[begin:i]
            if not hashes:
                value = value.replace('\\"', '"').replace("\\\\", "\\")
            values.add(value)
            i += len(closing)
    return values


def named_record_paths(paths: set[str], literals: set[str]) -> set[str]:
    """Match exact paths, or finite literal substitutions; never include a tree."""
    prefixes = tuple(directory + "/" for directory in RECORD_DIRECTORIES)
    templates = {value for value in literals if value.startswith(prefixes)}
    # appendingPathComponent("id.json") / Python path literals may name the
    # directory and leaf separately. Both components must occur as constants.
    directories = {value.rstrip("/") for value in templates
                   if any(path.startswith(value.rstrip("/") + "/") for path in paths)}
    leaves = {value for value in literals if "/" not in value and
              re.search(r"\.[A-Za-z0-9]+$", value)}
    templates.update(directory + "/" + leaf for directory in directories for leaf in leaves)
    selected = paths.intersection(templates)
    for template in templates:
        # Swift interpolation and supported Python f-strings use the same
        # internal spelling. Only substitutions that are themselves constants
        # in this test source can match a tracked filename.
        pieces = re.split(r"\\#*\(([A-Za-z_][A-Za-z0-9_]*)\)", template)
        if len(pieces) == 1:
            continue
        pattern = "".join(re.escape(part) if index % 2 == 0 else "([^/]+)"
                          for index, part in enumerate(pieces))
        for path in paths:
            match = re.fullmatch(pattern, path)
            if match and all(value in literals for value in match.groups()):
                selected.add(path)
    return selected


def named_record_folders(paths: set[str], literals: set[str]) -> set[str]:
    """Retain tracked folders named by static directory/prefix literals.

    The record roots themselves remain excluded. A dynamic expression may use
    question.id (or any runtime value); its containing, statically named folder
    is the boundary. Unmatched record folders are never expanded.
    """
    prefixes = tuple(directory + "/" for directory in RECORD_DIRECTORIES)
    folders = {str(parent) for path in paths for parent in Path(path).parents
               if str(parent).startswith(prefixes)}
    selected = set()
    for value in literals:
        if not value.startswith(prefixes):
            continue
        candidates = {value.rstrip("/")}
        dynamic = re.search(r"\\#*\(|\$\{|\$[A-Za-z_]", value)
        if dynamic:
            prefix = value[:dynamic.start()]
            candidates.add(prefix.rstrip("/") if prefix.endswith("/") else prefix.rpartition("/")[0])
        selected.update(candidates.intersection(folders))
    return selected


def committed_test_inputs(source: Path, revision: str, *, folder_details=None) -> tuple[dict, dict]:
    """Use the requested Git tree, never another lane's working files."""
    listing = subprocess.check_output(["git", "-C", str(source), "ls-tree", "-r", "-z",
                                      revision, "--", "apps/ios/Tests", "scripts",
                                      *RECORD_DIRECTORIES])
    entries = {}
    for row in listing.split(b"\0"):
        if row:
            header, name = row.split(b"\t", 1)
            mode, kind, oid = header.decode("ascii").split()
            entries[os.fsdecode(name)] = (mode, kind, oid)
    records = {name: entry for name, entry in entries.items()
               if name.startswith(tuple(directory + "/" for directory in RECORD_DIRECTORIES))}
    references = {}
    for name, (mode, kind, oid) in entries.items():
        path = Path(name)
        eligible = (name.startswith("apps/ios/Tests/") and path.suffix == ".swift") or (
            name.startswith("scripts/") and path.suffix in (".py", ".sh") and
            (path.name.startswith("test_") or path.stem.endswith("_test")))
        if not eligible or kind != "blob" or mode not in ("100644", "100755"):
            continue
        text = subprocess.check_output(["git", "-C", str(source), "cat-file", "blob", oid]).decode("utf-8")
        literals = test_string_literals(text, path.suffix)
        targets = named_record_paths(set(records), literals)
        for folder in named_record_folders(set(records), literals):
            targets.update(target for target in records if target.startswith(folder + "/"))
            if folder_details is not None:
                folder_details.setdefault(folder, []).append(name)
        for target in targets:
            if records[target][0] not in ("100644", "100755"):
                raise ValueError("a named test input is not a regular tracked file")
            references.setdefault(target, []).append(name)
    return records, references


def exact_sparse_pattern(path: str) -> str:
    if any(ord(character) < 32 for character in path):
        raise ValueError("control characters are not supported in sparse input paths")
    return "/" + re.sub(r"([\\*?\[\]])", r"\\\1", path)


REDACT_GIT_ERRORS = False


def worktree_git(cwd, *args, lock_fd=None, raw=False):
    # Inherited Git routing can silently redirect even an explicit -C.
    if any(os.environ.get(key) for key in (
            "GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE")):
        raise ValueError("inherited Git routing refused")
    value = subprocess.check_output(["git", "-C", str(cwd), *args],
        env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"},
        pass_fds=(() if lock_fd is None else (lock_fd,)),
        stderr=subprocess.PIPE if REDACT_GIT_ERRORS else None)
    return value if raw else value.decode().strip()


def atomic_json(path: Path, value: dict, *, replace=False) -> None:
    """Publish whole JSON, durably; receipts retain exclusive-create semantics."""
    fd, temporary = tempfile.mkstemp(prefix=path.name + ".", dir=path.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(value, stream, ensure_ascii=False, indent=2)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        if replace:
            os.replace(temporary, path)
        else:
            os.link(temporary, path)
        directory = os.open(path.parent, os.O_RDONLY)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


PRIVATE_ROOT = None  # __FLEET_PRIVATE_ROOT_ASSIGNMENT__


def private_receipt_path(receipt, explicit=None):
    # Bind to the resolved public receipt without exposing its name in the private filename.
    if PRIVATE_ROOT is None:
        raise ValueError("private receipt root is not configured")
    if not os.path.ismount(PRIVATE_ROOT):
        raise ValueError("private volume is not mounted")
    root = PRIVATE_ROOT.resolve(strict=True)
    target = (explicit if explicit is not None else
              root / "station-materials" / (hashlib.sha256(os.fsencode(str(receipt))).hexdigest() + ".json"))
    target = Path(target).absolute()
    if target.is_symlink() or not target.resolve().is_relative_to(root) or target.resolve() == root:
        raise ValueError("private receipt must be inside the private volume")
    return target


def public_worktree_receipt(full):
    result = dict(full)
    for key in ("required_test_inputs", "included_test_folders"):
        rows = result.pop(key)
        encoded = json.dumps(rows, ensure_ascii=False, sort_keys=True, separators=(",", ":")).encode("utf-8")
        result[key + "_count"] = len(rows)
        result[key + "_sha256"] = hashlib.sha256(encoded).hexdigest()
    return result


class WorktreeState:
    def __init__(self, path, request, previous=None):
        self.path = path
        self.value = previous or {"version": 1, "request": request, "history": []}

    def record(self, stage, status, exit_code=None):
        event = {"stage": stage, "status": status,
                 "timestamp": datetime.now(timezone.utc).isoformat(), "exit": exit_code}
        self.value.update(event)
        self.value["history"].append(event)
        atomic_json(self.path, self.value, replace=True)


@contextmanager
def worktree_lock(path, *, dry_run=False):
    # Keep the inode: unlinking a flock file would permit two different locks.
    if dry_run and not os.path.lexists(path):
        yield None
        return
    fd = os.open(path, os.O_RDWR | os.O_NOFOLLOW | (0 if dry_run else os.O_CREAT), 0o600)
    try:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise ValueError("worktree operation is still active; preserve incomplete worktree")
        # A mutating git subprocess inherits fd, so killing Python cannot unlock
        # a still-running checkout. Closing, rather than LOCK_UN, releases it.
        yield fd
    finally:
        os.close(fd)


def worktree_registration(source, destination, branch, identity):
    listing = worktree_git(source, "worktree", "list", "--porcelain", "-z", raw=True)
    matches = []
    for block in listing.split(b"\0\0"):
        fields = dict(row.partition(b" ")[::2] for row in block.split(b"\0") if row)
        if b"worktree" in fields and Path(os.fsdecode(fields[b"worktree"])).resolve() == destination:
            matches.append(fields)
    if len(matches) != 1:
        raise ValueError("destination is not registered to the requested source repository")
    row = matches[0]
    if b"locked" in row or b"prunable" in row:
        raise ValueError("locked or prunable worktree refused")
    if row.get(b"branch") != os.fsencode("refs/heads/" + branch) or row.get(b"HEAD") != identity.encode():
        raise ValueError("worktree branch or revision mismatch; preserve incomplete worktree")
    common = lambda root: Path(worktree_git(root, "rev-parse", "--path-format=absolute", "--git-common-dir")).resolve()
    if common(source) != common(destination) or Path(worktree_git(destination, "rev-parse", "--show-toplevel")).resolve() != destination:
        raise ValueError("worktree repository identity mismatch; preserve incomplete worktree")
    if worktree_git(destination, "symbolic-ref", "HEAD") != "refs/heads/" + branch or worktree_git(destination, "rev-parse", "HEAD") != identity:
        raise ValueError("worktree branch or revision mismatch; preserve incomplete worktree")


def checkout_only_issues(source, destination, identity):
    """Compare index AND every present node to HEAD, including ignored files.

    Missing tracked nodes/index entries are allowed. An absent index after
    --no-checkout makes even original files look untracked to git status.
    Compare actual blobs instead of trusting porcelain's deletion labels.
    """
    expected = {}
    for row in worktree_git(source, "ls-tree", "-r", "-z", identity, raw=True).split(b"\0"):
        if row:
            header, path = row.split(b"\t", 1)
            mode, kind, oid = header.decode().split()
            expected[os.fsdecode(path)] = (mode, kind, oid)
    issues = []
    for row in worktree_git(destination, "ls-files", "--stage", "-z", raw=True).split(b"\0"):
        if row:
            header, path = row.split(b"\t", 1)
            mode, oid, stage = header.decode().split()
            name = os.fsdecode(path)
            if stage != "0" or expected.get(name) != (mode, "blob", oid):
                issues.append({"path": name, "reason": "index differs from requested commit"})
    folders = {str(parent) for name in expected for parent in Path(name).parents if str(parent) != "."}
    for root, directories, files in os.walk(destination, followlinks=False):
        for leaf in list(directories) + files:
            path = Path(root) / leaf
            name = path.relative_to(destination).as_posix()
            if name == ".git":
                if path.is_symlink() or not path.is_file():
                    issues.append({"path": name, "reason": "unexpected worktree control node"})
                if leaf in directories:
                    directories.remove(leaf)
                continue
            info = path.lstat()
            if stat.S_ISDIR(info.st_mode):
                if name not in folders:
                    issues.append({"path": name, "reason": "untracked directory"})
                    directories.remove(leaf)
                continue
            entry = expected.get(name)
            if entry is None or entry[1] != "blob":
                issues.append({"path": name, "reason": "untracked or unsupported node"})
                continue
            mode, _, oid = entry
            if stat.S_ISLNK(info.st_mode):
                actual = os.fsencode(os.readlink(path))
                valid_mode = mode == "120000"
            elif stat.S_ISREG(info.st_mode):
                actual = path.read_bytes()
                valid_mode = mode == ("100755" if info.st_mode & 0o111 else "100644")
            else:
                issues.append({"path": name, "reason": "special node"})
                continue
            original = worktree_git(source, "cat-file", "blob", oid, raw=True)
            if not valid_mode or actual != original:
                issues.append({"path": name, "reason": "working content or mode differs from requested commit"})
    return issues


def origin_head(source, branch):
    try:
        result = subprocess.run(["git", "-C", str(source), "ls-remote", "--exit-code", "--refs",
                                 "origin", "refs/heads/" + branch],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60,
                                env={**os.environ, "GIT_OPTIONAL_LOCKS": "0", "GIT_TERMINAL_PROMPT": "0"})
    except (OSError, subprocess.TimeoutExpired):
        raise ValueError("origin branch check unavailable") from None
    rows = result.stdout.splitlines()
    if result.returncode or len(rows) != 1:
        raise ValueError("origin branch unavailable or absent")
    fields = rows[0].split(b"\t")
    if len(fields) != 2 or fields[1] != os.fsencode("refs/heads/" + branch):
        raise ValueError("origin branch response invalid")
    return fields[0].decode("ascii")


def published_head(source, destination, branch):
    """Require the local worktree head to equal the live origin branch tip."""
    head = worktree_git(destination, "rev-parse", "HEAD")
    worktree_registration(source, destination, branch, head)
    if origin_head(source, branch) != head:
        raise ValueError("origin branch commit differs from worktree HEAD")
    return head


def registration_at(source, destination):
    listing = worktree_git(source, "worktree", "list", "--porcelain", "-z", raw=True)
    matches = []
    for block in listing.split(b"\0\0"):
        fields = dict(row.partition(b" ")[::2] for row in block.split(b"\0") if row)
        if fields.get(b"worktree") == os.fsencode(str(destination)):
            matches.append(fields)
    if len(matches) > 1:
        raise ValueError("worktree registration mismatch")
    return matches[0] if matches else None


def published_audit(source, destination, branch):
    head = published_head(source, destination, branch)
    status = worktree_git(destination, "status", "--porcelain=v1", "-z", "--untracked-files=no", raw=True)
    if status:
        raise ValueError("tracked changes present")
    issues = checkout_only_issues(source, destination, head)
    if issues:
        raise ValueError("unique or changed filesystem nodes: count=" + str(len(issues)))
    # Include open files, cwd and executable references below the exact tree.
    # lsof exits 1 for no matches; any other error is not evidence of safety.
    try:
        result = subprocess.run(["lsof", "-n", "-P", "-Fpn", "+D", str(destination)],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        raise ValueError("process use check unavailable") from None
    if result.returncode not in (0, 1) or result.stderr:
        raise ValueError("process use check failed")
    if result.stdout:
        raise ValueError("worktree in use by process")
    return head


def close_published(args):
    global REDACT_GIT_ERRORS
    REDACT_GIT_ERRORS = True
    destination = args.destination.absolute()
    if destination.is_symlink():
        raise ValueError("symlink destination refused")
    if not destination.parent.is_dir():
        raise ValueError("destination parent unavailable")
    destination = destination.resolve()
    source = args.source.resolve(strict=True)
    receipt = args.receipt.parent.resolve() / args.receipt.name
    if receipt.is_relative_to(destination):
        raise ValueError("receipt must be outside the source worktree")
    state_path = destination.with_name(destination.name + ".station-materials-state.json")
    lock_path = destination.with_name(destination.name + ".station-materials.lock")
    identity = worktree_git(source, "rev-parse", "--verify", args.revision + "^{commit}")
    worktree_git(source, "check-ref-format", "refs/heads/" + args.branch)
    request = {"source": str(source), "common_dir": worktree_git(source, "rev-parse", "--path-format=absolute", "--git-common-dir"),
               "destination": str(destination), "branch": args.branch, "revision": identity,
               "receipt": str(receipt)}
    with worktree_lock(lock_path, dry_run=args.dry_run) as lock_fd:
        if state_path.is_symlink() or not state_path.is_file():
            raise ValueError("worktree state file required")
        previous = json.loads(state_path.read_text())
        if previous.get("version") != 1 or previous.get("request") != request:
            raise ValueError("worktree state request mismatch")
        exists = os.path.lexists(destination)
        registration = None if exists else registration_at(source, destination)
        if previous.get("status") == "cleaned":
            if previous.get("stage") == "published-close" and not exists and registration is None:
                print("worktree already closed")
                return
            raise ValueError("worktree already cleaned or registration mismatch")
        recovering = previous.get("stage") == "published-remove"
        if exists:
            head = published_audit(source, destination, args.branch)
            if recovering and previous.get("published_head") != head:
                raise ValueError("worktree changed since interrupted removal")
        elif not recovering:
            raise ValueError("destination absent without published removal state")
        elif registration is not None:
            head = previous.get("published_head")
            if (not isinstance(head, str) or registration.get(b"branch") != os.fsencode("refs/heads/" + args.branch)
                    or registration.get(b"HEAD") != head.encode() or b"locked" in registration
                    or worktree_git(source, "rev-parse", "refs/heads/" + args.branch) != head
                    or origin_head(source, args.branch) != head):
                raise ValueError("interrupted worktree registration mismatch")
        if args.dry_run:
            print(json.dumps({"dry_run": True, "actions": ["verify live origin, clean tree and process use", "remove exact worktree", "retain local branch", "record cleaned state"]}))
            return
        journal = WorktreeState(state_path, request, previous)
        try:
            if exists:
                journal.value["published_head"] = head
                journal.record("published-remove", "running")
                if published_audit(source, destination, args.branch) != head:
                    raise ValueError("worktree changed during audit")
                worktree_git(source, "worktree", "remove", "--force", str(destination), lock_fd=lock_fd)
            elif registration is not None:
                # Exact missing destination only: no broad prune and no branch removal.
                if os.path.lexists(destination) or origin_head(source, args.branch) != head:
                    raise ValueError("worktree changed during recovery")
                worktree_git(source, "worktree", "remove", "--force", str(destination), lock_fd=lock_fd)
            journal.record("published-close", "cleaned", 0)
        except BaseException as error:
            code = error.code if isinstance(error, SystemExit) else 1
            journal.record(journal.value["stage"], "failed", code)
            raise



def managed_worktree(args):
    global REDACT_GIT_ERRORS
    REDACT_GIT_ERRORS = True
    destination = args.destination.absolute()
    if destination.is_symlink():
        raise ValueError("symlink destination refused")
    # Preserve the original normal-path preconditions and their order.
    if not (args.resume or args.cleanup) and os.path.lexists(destination):
        raise FileExistsError(destination)
    if not destination.parent.is_dir():
        raise ValueError(f"allocate the destination parent first: the parent directory {destination.parent} does not exist; create it yourself with mkdir -p (a plain directory, not a governor allocation), then run the same command again")
    destination = destination.resolve()
    source = args.source.resolve(strict=True)
    receipt = args.receipt.parent.resolve() / args.receipt.name
    if receipt.is_relative_to(destination):
        raise ValueError("receipt must be outside the source worktree")
    private_receipt = None if args.cleanup else private_receipt_path(receipt, getattr(args, "private_receipt", None))
    state_path = destination.with_name(destination.name + ".station-materials-state.json")
    lock_path = destination.with_name(destination.name + ".station-materials.lock")
    identity = worktree_git(source, "rev-parse", "--verify", args.revision + "^{commit}")
    worktree_git(source, "check-ref-format", "refs/heads/" + args.branch)
    request = {"source": str(source), "common_dir": worktree_git(source, "rev-parse", "--path-format=absolute", "--git-common-dir"),
               "destination": str(destination), "branch": args.branch, "revision": identity,
               "receipt": str(receipt)}
    with worktree_lock(lock_path, dry_run=args.dry_run) as lock_fd:
        if not (args.resume or args.cleanup):
            branch_exists = subprocess.run(["git", "-C", str(source), "show-ref", "--verify", "--quiet", "refs/heads/" + args.branch],
                env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"}).returncode
            if branch_exists == 0:
                raise ValueError("branch already exists; preserve existing branch")
            if branch_exists != 1:
                raise ValueError("cannot establish branch ownership")
        previous = None
        if os.path.lexists(state_path):
            if state_path.is_symlink() or not state_path.is_file():
                raise ValueError("invalid worktree state file")
            previous = json.loads(state_path.read_text())
            if not (args.resume or args.cleanup):
                raise FileExistsError(state_path)
            if previous.get("version") != 1 or previous.get("request") != request:
                raise ValueError("worktree state request mismatch; preserve incomplete worktree")
            if previous.get("status") == "cleaned":
                raise ValueError("worktree already cleaned")
        elif args.resume:
            raise ValueError("worktree state file is required for resume")
        exists = os.path.lexists(destination)
        if exists:
            worktree_registration(source, destination, args.branch, identity)
            issues = checkout_only_issues(source, destination, identity)
            if issues:
                raise ValueError("unique data or changes; preserve incomplete worktree: count=" + str(len(issues)))
        elif args.cleanup:
            # A prior cleanup may have removed the tree before branch deletion.
            if previous is None or previous.get("stage") not in ("cleanup-remove", "cleanup-branch"):
                raise ValueError("cleanup destination is absent without a removal state")
        if args.dry_run:
            print(json.dumps({"dry_run": True, "request": request, "actions": (
                ["git worktree remove --force (only after checkout-only audit)", "delete exact branch with expected commit", "record cleaned state"] if args.cleanup else
                (["register worktree"] if not exists else []) + ["set sparse checkout", "read-tree -mu HEAD", "verify identity and exclusions", "write receipt", "record complete state"])}, indent=2))
            return
        journal = WorktreeState(state_path, request, previous)
        def interrupted(signum, frame):
            raise SystemExit(128 + signum)
        handlers = {sig: signal.signal(sig, interrupted) for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP)}
        try:
            journal.record("start", "running")
            if args.cleanup:
                journal.record("cleanup-remove", "running")
                if exists:
                    # Recheck immediately before the irreversible operation.
                    worktree_registration(source, destination, args.branch, identity)
                    if checkout_only_issues(source, destination, identity):
                        raise ValueError("worktree changed during audit; preserve incomplete worktree")
                    worktree_git(source, "worktree", "remove", "--force", str(destination), lock_fd=lock_fd)
                journal.record("cleanup-branch", "running")
                current = subprocess.run(["git", "-C", str(source), "show-ref", "--verify", "--quiet", "refs/heads/" + args.branch],
                    env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"}).returncode
                if current == 0:
                    worktree_git(source, "update-ref", "-d", "refs/heads/" + args.branch, identity, lock_fd=lock_fd)
                elif current != 1:
                    raise ValueError("cannot establish cleanup branch identity")
                journal.record("cleanup", "cleaned", 0)
                return
            if os.path.lexists(receipt):
                # A kill after atomic receipt publication can be resumed safely.
                if not args.resume or receipt.is_symlink():
                    raise FileExistsError(receipt)
            result = source_worktree(source, destination, args.branch, identity,
                journal=journal, lock_fd=lock_fd, resume=args.resume)
            journal.record("receipt", "running")
            public = public_worktree_receipt(result)
            # Recheck mount and containment immediately before publishing private data.
            private_receipt = private_receipt_path(receipt, getattr(args, "private_receipt", None))
            private_receipt.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            private_receipt = private_receipt_path(receipt, getattr(args, "private_receipt", None))
            if os.path.lexists(private_receipt):
                if not args.resume or private_receipt.is_symlink() or json.loads(private_receipt.read_text()) != result:
                    raise ValueError("existing private receipt mismatch; preserve incomplete worktree")
            else:
                atomic_json(private_receipt, result)
            if os.path.lexists(receipt):
                existing = json.loads(receipt.read_text())
                if existing != public and existing != result:
                    raise ValueError("existing receipt mismatch; preserve incomplete worktree")
            else:
                atomic_json(receipt, public)
            journal.record("complete", "complete", 0)
        except BaseException as error:
            code = error.code if isinstance(error, SystemExit) else (128 + signal.SIGINT if isinstance(error, KeyboardInterrupt) else 1)
            journal.record(journal.value["stage"], "failed", code)
            raise
        finally:
            for sig, handler in handlers.items():
                signal.signal(sig, handler)


def source_worktree(source: Path, destination: Path, branch: str, revision: str,
                    *, journal=None, lock_fd=None, resume=False) -> dict:
    """Materialize source and its statically named tracked test inputs.

    The Git objects and canonical checkout remain intact. A lane that needs an
    excluded record reads the existing original. Named files and tracked files
    inside test-named folders are reincluded as exact patterns; dependencies and
    build products are never copied here.
    """
    if os.path.lexists(destination) and not resume:
        raise FileExistsError(destination)
    if not destination.parent.is_dir():
        raise ValueError(f"allocate the destination parent first: the parent directory {destination.parent} does not exist; create it yourself with mkdir -p (a plain directory, not a governor allocation), then run the same command again")

    def git(cwd, *args):
        return worktree_git(cwd, *args, lock_fd=lock_fd)

    def stage(name, action):
        if journal:
            journal.record(name, "running")
        action()
        if journal:
            journal.record(name, "done", 0)

    identity = git(source, "rev-parse", "--verify", revision + "^{commit}")
    folder_details = {}
    record_entries, references = committed_test_inputs(source, identity, folder_details=folder_details)
    # --no-checkout avoids writing the archive even briefly before sparsifying.
    if not os.path.lexists(destination):
        def add():
            # add may create its branch just before an interruption. Reuse only
            # with the matching durable request and exact original commit.
            if resume and subprocess.run(["git", "-C", str(source), "show-ref", "--verify", "--quiet", "refs/heads/" + branch]).returncode == 0:
                if git(source, "rev-parse", "refs/heads/" + branch) != identity:
                    raise ValueError("branch revision mismatch; preserve incomplete worktree")
                git(source, "worktree", "add", "--no-checkout", str(destination), branch)
            else:
                git(source, "worktree", "add", "--no-checkout", "-b", branch, str(destination), identity)
        stage("register", add)
    stage("sparse", lambda: git(destination, "sparse-checkout", "set", "--no-cone", "/*",
        *("!/" + directory + "/" for directory in RECORD_DIRECTORIES),
        *(exact_sparse_pattern(path) for path in sorted(references))))
    stage("checkout", lambda: git(destination, "read-tree", "-mu", "HEAD"))
    if journal:
        journal.record("verify", "running")
    if git(destination, "rev-parse", "HEAD") != identity:
        raise ValueError("worktree identity mismatch; preserve incomplete worktree")
    if any(os.path.lexists(destination / path) for path in record_entries if path not in references):
        raise ValueError("record exclusion failed; preserve incomplete worktree")
    inputs = []
    for path in sorted(references):
        expected = subprocess.check_output(["git", "-C", str(source), "cat-file", "blob",
                                            record_entries[path][2]])
        actual = fingerprint(destination / path)
        if actual["sha256"] != hashlib.sha256(expected).hexdigest() or actual["bytes"] != len(expected):
            raise ValueError("test input identity mismatch; preserve incomplete worktree")
        inputs.append({"path": path, "sha256": actual["sha256"], "bytes": actual["bytes"],
                       "test_sources": references[path]})
    result = {"method": "source-worktree", "source": str(source.resolve()),
            "destination": str(destination.resolve()), "branch": branch,
            "commit": identity, "excluded_records": list(RECORD_DIRECTORIES),
            "required_test_inputs": inputs,
            "required_test_input_bytes": sum(row["bytes"] for row in inputs),
            "included_test_folders": [
                {"path": folder,
                 "file_count": sum(row["path"].startswith(folder + "/") for row in inputs),
                 "bytes": sum(row["bytes"] for row in inputs if row["path"].startswith(folder + "/")),
                 "test_sources": sorted(set(folder_details[folder]))}
                for folder in sorted(folder_details)],
            "excluded_tracked_record_count": len(record_entries) - len(inputs),
            "dependency_copy_bytes": 0, "historical_record_copy_bytes": 0}
    if journal:
        journal.record("verify", "done", 0)
    return result


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    reference = sub.add_parser("reference")
    reference.add_argument("--station", required=True)
    reference.add_argument("--project", default="examforge")
    reference.add_argument("--output", type=Path, required=True)
    reference.add_argument("--input", type=Path, action="append", required=True)
    verify = sub.add_parser("verify")
    verify.add_argument("manifest", type=Path)
    clone = sub.add_parser("clone")
    clone.add_argument("source", type=Path)
    clone.add_argument("destination", type=Path)
    clone.add_argument("--receipt", type=Path, required=True)
    project = sub.add_parser("project")
    project.add_argument("name")
    worktree = sub.add_parser("worktree")
    worktree.add_argument("--source", type=Path, required=True)
    worktree.add_argument("--destination", type=Path, required=True)
    worktree.add_argument("--branch", required=True)
    worktree.add_argument("--revision", required=True)
    worktree.add_argument("--receipt", type=Path, required=True)
    worktree.add_argument("--private-receipt", type=Path)
    recovery = worktree.add_mutually_exclusive_group()
    recovery.add_argument("--resume", action="store_true")
    recovery.add_argument("--cleanup", action="store_true")
    recovery.add_argument("--close-published", action="store_true")
    worktree.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)
    try:
        if args.command == "reference":
            rows = [fingerprint(p) for p in args.input]
            write_new_json(args.output, {"version": 1, "station": args.station,
                "project": canonical_project(args.project), "method": "reference",
                "copied_payload_bytes": 0, "inputs": rows})
        elif args.command == "verify":
            value = json.loads(args.manifest.read_text())
            if value.get("version") != 1 or value.get("method") != "reference" or not value.get("inputs"):
                raise ValueError("unsupported or empty manifest")
            if not all(verify_reference(r) for r in value["inputs"]):
                raise ValueError("reference verification failed")
        elif args.command == "clone":
            if os.path.lexists(args.receipt):
                raise FileExistsError(args.receipt)
            result = clone_file(args.source, args.destination)
            write_new_json(args.receipt, result)
        elif args.command == "worktree":
            if os.path.lexists(args.receipt) and not (args.resume or args.cleanup or args.close_published):
                raise FileExistsError(args.receipt)
            if args.close_published:
                close_published(args)
            else:
                managed_worktree(args)
        else:
            print(canonical_project(args.name))
    except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError) as error:
        if args.command == "worktree" and not isinstance(error, ValueError):
            print("station-materials: worktree inspection or operation failed", file=sys.stderr)
        else:
            print(f"station-materials: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

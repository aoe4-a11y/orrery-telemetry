<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily size-based rotation of ~/.agentstack/runtime/*.log and
  ~/.agentstack/mail-service/runtime/*.log (rootless LaunchAgent).
  mail-service/runtime was "not approved for rotation" until 2026-10-14: head
  mail 24844 approved it because agentstack-mailctl opens the log with ">>"
  (O_APPEND), so copytruncate leaves no sparse hole (measured: 5.98 GB log
  rotated with 0 lost bytes). The oldest archive is gzipped into
  AGENTSTACK_LOG_ROTATE_ARCHIVE_DIR (encrypted DevSSD-Private records root)
  with a SHA-checked tombstone instead of being deleted (storage v5.9).

  Preparation only: scripts/install.sh does not install this. Deployment is
  the head's job and needs BOTH steps — copying the plist alone starts a job
  whose script does not exist:
    1. install -m 0755 scripts/rotate_runtime_logs.sh ~/.agentstack/hooks/rotate_runtime_logs.sh
    2. sed "s|/Users/huyuhutaru|$HOME|g" scripts/launchd/org.agentstack.runtime-log-rotate.plist \
         > ~/Library/LaunchAgents/org.agentstack.runtime-log-rotate.plist
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/org.agentstack.runtime-log-rotate.plist
    3. dry run first: ~/.agentstack/hooks/rotate_runtime_logs.sh --dry-run ~/.agentstack/runtime
  Remove with: launchctl bootout gui/$(id -u)/org.agentstack.runtime-log-rotate

  The rotated jobs keep their own StandardOutPath: the script copies and
  truncates in place (see scripts/rotate_runtime_logs.sh, "Semantics"; the
  50 MiB value is the rotation threshold checked once per run, not a cap on
  the archive size — a busy log overshoots it between runs).
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.agentstack.runtime-log-rotate</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec /bin/bash "$HOME/.agentstack/hooks/rotate_runtime_logs.sh" "$HOME/.agentstack/runtime" "$HOME/.agentstack/mail-service/runtime"</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>AGENTSTACK_LOG_ROTATE_THRESHOLD_BYTES</key>
        <string>52428800</string>
        <key>AGENTSTACK_LOG_ROTATE_KEEP</key>
        <string>3</string>
        <key>AGENTSTACK_LOG_ROTATE_ARCHIVE_DIR</key>
        <string>/Volumes/DevSSD-Private/DevStorageGovernor/artifacts/orrery-telemetry/20261014T173010Z-private-evidence-177b78c0/records/runtime-logs</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>Nice</key>
    <integer>10</integer>
    <key>StandardOutPath</key>
    <string>/Users/huyuhutaru/.agentstack/runtime/log-rotate.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/huyuhutaru/.agentstack/runtime/log-rotate.log</string>
</dict>
</plist>

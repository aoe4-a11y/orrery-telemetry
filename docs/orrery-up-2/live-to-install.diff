+        except sqlite3.Error:
+            return False
+        for row in rows:
+            # First in last_active_ts DESC order wins, as with LIMIT 1.
+            self.by_name.setdefault(row["name"], int(row["id"]))
+            if row["human_key"] is not None:
+                self.by_project.setdefault((row["human_key"], row["name"]), row)
+        self.usable = True

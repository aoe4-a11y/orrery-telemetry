+        "--overlay",
+        os.environ.get("AGENTSTACK_CODEX_CHILD_CONFIG_OVERLAY", "").strip(),
+        # A child in a git worktree keeps the hook trust given to its source.
+        "--work-dir",
+        work_dir,

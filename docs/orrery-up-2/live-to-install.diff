+        "--child",
+        session,
+        "--project-key",
+        registration["project_key"],
+        "--token-file",
+        token_file,
+        "--mcp-url",
+        _env_text("AGENTSTACK_MCP_URL", "http://127.0.0.1:18765/mcp"),
+        "--mail-env",

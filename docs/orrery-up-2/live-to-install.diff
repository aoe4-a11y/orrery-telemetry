+# The order itself, with no I/O: EXPLICIT, else INSTALLED, else DEFAULT.
+# An empty value counts as not given.
+agentstack_pick_setting() {
+    if [ -n "${1:-}" ]; then
+        printf '%s\n' "$1"
+    elif [ -n "${2:-}" ]; then
+        printf '%s\n' "$2"
+    else
+        printf '%s\n' "${3:-}"

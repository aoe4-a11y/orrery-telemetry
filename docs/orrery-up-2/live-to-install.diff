+    local env_file="${4:-${AGENTSTACK_HOME:-$HOME/.agentstack}/env.sh}"
+    local installed=""
+    if [ -z "$explicit" ]; then
+        installed="$(agentstack_installed_env_value "$name" "$env_file")"
+    fi

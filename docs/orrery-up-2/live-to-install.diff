+    g.resumeCapability||(resumeState?'provenance_missing':'not_required');
+  const openBtn=TM('tm-open');
+  if(openBtn){
+    const verificationRequired=capability==='verification_required';
+    const unavailable=resumeState&&capability!=='ready'&&!verificationRequired;
+    openBtn.disabled=unavailable;
+    openBtn.style.opacity=unavailable?'.5':'';
+    openBtn.style.cursor=unavailable?'not-allowed':'';
+    openBtn.style.background=unavailable?'transparent':'';
+    openBtn.style.color=unavailable?'var(--cyan)':'';
+    openBtn.style.boxShadow=unavailable?'none':'';
+    const view=resumeButtonView(resumeState,capability,a.resume_mode||g.resume_mode,
+      a.mail_message||g.mail_message,EMBED_MODE);
+    openBtn.textContent=view.text;
+    openBtn.title=view.title;
+  }
+}
+// The panel agent's state: a deck row, or a graph node in the same shape
+// renderPanelButtons reads; null when that source no longer lists the agent.
+// The view on screen refreshes its own source and the other one goes stale,

            "command": "/bin/bash /Users/huyuhutaru/.agentstack/hooks/release-file-reservation.sh"
          }
        ]
      },
      {
        "matcher": "mcp__orrery-mail__register_agent|mcp__mcp-agent-mail__register_agent|mcp__agent_mail__register_agent",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash /Users/huyuhutaru/.agentstack/hooks/mark-agent-registered.sh"
          }
        ]
      },
      {
        "matcher": "mcp__orrery-mail__send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /Users/huyuhutaru/.agentstack/hooks/head-send-lint.py",
            "timeout": 90
          }
        ]
      },
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
